{
  "name": "clanker-faker",
  "private": true,
  "version": "1.0.0",
  "description": "A browser-based social deduction game about acting like a bot and catching the human.",
  "homepage": "https://clankerfaker.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NitsuaParrhesia/clankerfaker.git"
  },
  "bugs": {
    "url": "https://github.com/NitsuaParrhesia/clankerfaker/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:pages": "wrangler pages dev dist",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "node scripts/acceptance.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "cf:typegen": "wrangler types functions/types.d.ts",
    "cf:types:check": "wrangler types functions/types.d.ts --check",
    "db:migrate:local": "wrangler d1 migrations apply clankerfaker-replays --local",
    "check": "npm run cf:types:check && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.132.0"
  }
}
